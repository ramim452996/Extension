# -----------------------------------------------------------------------------
# Root .gitignore — Compare Anything (SPEC Section 42 Compliance)
# -----------------------------------------------------------------------------

# 1. Environment & Secrets
.env
.env.*
!.env.example
*.key
*.pem

# 2. Production Secrets & ASP.NET Configuration
appsettings*.json
!appsettings.json
!appsettings.Development.json.example

# 3. Local Build Outputs & Dependencies
node_modules/
dist/
bin/
obj/
out/
*.zip
/vendor
/public/build
/public/hot
/public/storage
/.phpunit.cache

# 4. Storage, Cache, and SQLite Databases
/storage/framework/cache/data/*
/storage/framework/views/*
/storage/logs/*.log
/storage/*.key
/storage/pail
database/*.sqlite
database/*.sqlite-journal
database/*.sqlite-wal
database/*.sqlite-shm

# 5. IDE, Editors, and OS Caches
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
