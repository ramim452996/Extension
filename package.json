{
  "name": "compare-anything-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "package": "vite build && powershell -Command \"Compress-Archive -Path dist/* -DestinationPath ../store-assets/compare-anything-v1.0.0.zip -Force\"",
    "type-check": "tsc --noEmit"
